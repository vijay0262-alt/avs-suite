{
  "name": "@avs/pc-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "AVS AI Shield: Security & System Intelligence — Windows performance, cleanup, and security utility.",
  "author": {
    "name": "Advanced Vision Software LLC",
    "email": "help@avsshield.com"
  },
  "publisherName": "Advanced Vision Software LLC",
  "main": "dist-electron/main/index.js",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "cross-env AVS_ENV=development electron .",
    "build": "tsc -p tsconfig.json --noEmit && vite build && cd electron && tsc",
    "build:backend": "cd ../../backend && python build.py",
    "download-clamav": "node scripts/download-clamav.js",
    "package": "yarn download-clamav && cross-env AVS_ENV=production yarn build && yarn build:backend && cross-env AVS_ENV=production electron-builder --win --x64",
    "package:installer": "yarn download-clamav && cross-env AVS_ENV=production yarn build && yarn build:backend && cross-env AVS_ENV=production electron-builder --win --x64 --config.nsis.oneClick=false",
    "package:portable": "yarn download-clamav && cross-env AVS_ENV=production yarn build && yarn build:backend && cross-env AVS_ENV=production electron-builder --win portable --x64",
    "package:all": "yarn download-clamav && cross-env AVS_ENV=production yarn build && yarn build:backend && cross-env AVS_ENV=production electron-builder --win --x64",
    "package:dir": "yarn download-clamav && cross-env AVS_ENV=production yarn build && yarn build:backend && cross-env AVS_ENV=production electron-builder --dir",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint \"{src,electron}/**/*.{ts,tsx}\" --max-warnings=0"
  },
  "dependencies": {
    "@heroicons/react": "^2.1.3",
    "electron-log": "^5.1.2",
    "electron-updater": "^6.1.8",
    "i18next": "^23.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.0",
    "react-router-dom": "^6.22.3",
    "react-window": "^1.8.10",
    "recharts": "^2.12.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "electron": "30.5.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.avs.pcoptimizer",
    "productName": "AVS AI Shield",
    "copyright": "Copyright © 2024-2026 Advanced Vision Software LLC. All rights reserved.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../backend/dist/backend-py",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./resources/clamav",
        "to": "clamav",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "./build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "./build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "./build/tray-icon.png",
        "to": "tray-icon.png"
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/main/index.js",
      "author": {
        "name": "Advanced Vision Software LLC",
        "email": "help@avsshield.com"
      },
      "publisherName": "Advanced Vision Software LLC"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-Setup.${ext}",
      "publisherName": "Advanced Vision Software LLC",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  }
}

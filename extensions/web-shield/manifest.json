{
  "manifest_version": 3,
  "name": "AVS AI Shield — Web Shield",
  "version": "1.0.0",
  "description": "Real-time scam and phishing protection powered by the local AVS AI Shield engine.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "webNavigation",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://www.messenger.com/*",
        "https://www.facebook.com/messages/*",
        "https://m.facebook.com/messages/*"
      ],
      "js": ["msg-scan.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
